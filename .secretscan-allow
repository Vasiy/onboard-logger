# Findings the pre-push secret scan should not stop on in this repository.
# One extended regex per line, matched against the scanner's own output lines,
# which look like `path:line:the matching text`.
#
# ANCHOR EVERY ENTRY TO A FILE (`^path:`). A bare pattern like `192\.168\.5\.`
# also matches any *other* line that happens to contain it — including one that
# carries a real password next to a harmless address — and silently hides it.
# Add a line only for something deliberately published, never to quiet a real
# credential.

# The board's own AP address and DHCP pool: product defaults, documented.
^config/config\.default\.json:.*192\.168\.5\.
^install\.sh:.*192\.168\.5\.
^README(\.ru)?\.md:.*192\.168\.5\.1

# The AP-recovery script reads network.ap_ip from the live config and falls back
# to the same product default when that read fails. Both shapes: the file is new,
# so the finding also arrives as an added line. Pinned to the fallback assignment
# itself, not to anything in the file that merely contains the address.
^systemd/wlan0-ap-recover\.sh:[0-9]+:AP_IP=.*\|\| echo 192\.168\.5\.1\)$
^\+AP_IP=.*\|\| echo 192\.168\.5\.1\)$

# The same product default in the install/upgrade reference, which exists once
# per UI locale. Both entries pin the *whole* line to the "where the UI lives"
# shape — a label, the address, the eth0 aside — rather than allowing anything in
# those files that merely contains the address: a credential parked on the same
# line stays visible, which is the failure this file's header is about. New
# files, so the finding arrives in both shapes.
^docs/DEPLOY(\.[a-z]{2})?\.md:[0-9]+:[^:]*:[ \t]+http://192\.168\.5\.1/[ \t]+\(.*eth0.*\)$
^\+[^:]*:[ \t]+http://192\.168\.5\.1/[ \t]+\(.*eth0.*\)$

# tests/ fixtures — invented addresses and a fake PSK for the client-mode and
# UI tests.
^tests/test_config_net\.py:.*(192\.168\.(1|5)\.|10\.(0|9)\.|secret123)
^tests/ui_dtc_copy\.js:.*192\.168\.4\.1

# deploy.sh never carries the host or the password: it reads .deploy.env and
# passes the value through $PASS.
^deploy\.sh:.*sshpass -p \$PASS

# UI test fixtures — a neutral AP-style address, not this board's. It moved into
# the shared DOM stub when the three harnesses started sharing one sandbox, so the
# stub inherits the ruling the two harnesses already carried — in both shapes,
# because this one arrives as a new file and so also as an added line.
^tests/ui_fw_ident\.js:.*192\.168\.4\.1
^tests/ui_sandbox\.js:.*192\.168\.4\.1
^\+.*location: \{ protocol: "http:", host: "192\.168\.4\.1" \},$
# The download harness needs a page address to navigate away from, and uses the
# same fixture. Pinned to that one accessor rather than to the file.
^tests/ui_downloads\.js:[0-9]+:[ \t]*get\(\) \{ return "http://192\.168\.4\.1/"; \},$
^\+[ \t]*get\(\) \{ return "http://192\.168\.4\.1/"; \},$

# A test fixture that was named secret.txt and renamed to outside.txt one commit
# later, for exactly this reason: a fixture that trips the scanner teaches
# everyone to wave it through. The tree no longer holds it — only the added line
# of the intermediate commit does, and that line is pinned here whole.
^\+[ \t]*secret = root\.parent / "secret\.txt"$

# The scanner filters two shapes: `path:line:text` for the working tree, and the
# raw `+added line` for outgoing commits — an entry has to match the shape it is
# meant to quiet. The three below are the scanner tripping over itself.
#
# In a diff the leading "+" of an added line plays the local part of an address,
# so a FastAPI route decorator line reads as one. (Spelling that decorator
# out here would trip the very pattern this entry exists to quiet.) The path is
# no longer pinned to /api/: an add-on's page is served from /addons/<name>/,
# outside it. Still anchored to the decorator shape at the start of the line —
# a credential cannot appear inside one.
^\+@app\.(get|post|put|delete|websocket)\("/
# This file necessarily quotes the patterns it allows: as a tree hit ...
^\.secretscan-allow:
# ... and as its own added lines, which are path-anchored regexes.
^\+\^[A-Za-z0-9_./\\-]+\\?\.[A-Za-z0-9]+:
# ... and once more for an entry that is itself `+`-shaped, i.e. one written to
# quiet an added line rather than a tree hit.
^\+\^\\\+

# scanner-note: the credential word appears in the UI's own vocabulary now that
# scanner-note: the messages are localised. Three shapes below, each anchored to
# scanner-note: what it actually is.
#
# 1. a locale table line. Each begins with err.no_response, so the anchor is the
#    start of that line rather than the word anywhere in it.
^\+ *"err\.no_response": "
^app/static/i18n\.js:[0-9]+: *"err\.no_response": "
# scanner-note: 2. the two validation keys that name a rule about one. A key is not a value.
^\+ *raise ConfigError\("cfgerr\.(ap|client)_password"\)$
^app/web/config_mgr\.py:[0-9]+: *raise ConfigError\("cfgerr\.(ap|client)_password"\)$
# scanner-note: 3. the canonical target of a path-traversal test -- these assert
#    that it is refused. Anchored to the traversal, so a bare path never matches.
^\+.*\.\..*etc/passwd
^tests/[a-z_]+\.(py|js):[0-9]+:.*\.\..*etc/passwd

# A comment in this very file that has to name what it is allowing. The marker is
# deliberate and only ever written here: a bare "^\+#" would quiet every added
# comment in the repository, which is the mistake this file warns about at the top.
^\+# scanner-note: 
^\.secretscan-allow:[0-9]+:# scanner-note: 
# ... and an added entry that is itself anchored to this file's name, which
# contains the word the scanner looks for. The sibling entry above matches the
# `path.ext:` shape and not this one, which ends at a colon after the name.
^\+\^\\\.secretscan-allow:
