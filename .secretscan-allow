# Findings the pre-push secret scan should not stop on in this repository.
# One extended regex per line, matched against the scanner's own output lines,
# which look like `path:line:the matching text`.
#
# ANCHOR EVERY ENTRY TO A FILE (`^path:`). A bare pattern like `192\.168\.5\.`
# also matches any *other* line that happens to contain it — including one that
# carries a real password next to a harmless address — and silently hides it.
# Add a line only for something deliberately published, never to quiet a real
# credential.

# The board's own AP address and DHCP pool: product defaults, documented.
^config/config\.default\.json:.*192\.168\.5\.
^install\.sh:.*192\.168\.5\.
^README(\.ru)?\.md:.*192\.168\.5\.1

# tests/ fixtures — invented addresses and a fake PSK for the client-mode and
# UI tests.
^tests/test_config_net\.py:.*(192\.168\.(1|5)\.|10\.(0|9)\.|secret123)
^tests/ui_dtc_copy\.js:.*192\.168\.4\.1

# Copyright line of a third-party decompile kept in this private archive.
^guzzidiag_V0\.61\.exe\.txt:.*info@hex-rays\.com

# deploy.sh never carries the host or the password: it reads .deploy.env and
# passes the value through $PASS.
^deploy\.sh:.*sshpass -p \$PASS

# UI test fixtures — a neutral AP-style address, not this board's.
^tests/ui_fw_ident\.js:.*192\.168\.4\.1

# The scanner filters two shapes: `path:line:text` for the working tree, and the
# raw `+added line` for outgoing commits — an entry has to match the shape it is
# meant to quiet. The three below are the scanner tripping over itself.
#
# In a diff the leading "+" of an added line plays the local part of an address,
# so a FastAPI route decorator line reads as one. (Spelling that decorator
# out here would trip the very pattern this entry exists to quiet.)
^\+@app\.(get|post|delete|websocket)\("/api/
# This file necessarily quotes the patterns it allows: as a tree hit ...
^\.secretscan-allow:
# ... and as its own added lines, which are path-anchored regexes.
^\+\^[A-Za-z0-9_./\\-]+\\?\.[A-Za-z0-9]+:
