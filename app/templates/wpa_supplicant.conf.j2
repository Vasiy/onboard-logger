# Generated by onboard-logger — do not edit by hand (see Config tab).
# Client (station) mode: this file is read by wpa_supplicant@{{ iface }}.service.
ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev
update_config=0
country={{ country }}

network={
	ssid="{{ client.ssid }}"
	scan_ssid=1
{% if client.password %}
	key_mgmt=WPA-PSK
	psk="{{ client.password }}"
{% else %}
	key_mgmt=NONE
{% endif %}
}
