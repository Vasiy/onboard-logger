# Generated by onboard-logger — do not edit by hand (see Config tab).
interface={{ iface }}
driver=nl80211
ssid={{ wifi.ssid }}
utf8_ssid=1
hw_mode=g
channel={{ wifi.channel }}
country_code={{ wifi.country }}
ieee80211d=1
auth_algs=1
wmm_enabled=1
macaddr_acl=0
ignore_broadcast_ssid=0
{% if wifi.password %}
wpa=2
wpa_passphrase={{ wifi.password }}
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
{% endif %}
