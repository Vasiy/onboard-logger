# Generated by onboard-logger — do not edit by hand (see Config tab).
# DHCP is served ONLY on the Wi-Fi interface.
interface={{ iface }}
bind-interfaces
except-interface=lo
dhcp-range={{ dhcp.pool_start }},{{ dhcp.pool_end }},{{ dhcp.lease }}
{% if network.gateway %}
dhcp-option=3,{{ network.gateway }}
{% else %}
# no router option: the AP does not route anywhere, clients get no default route
dhcp-option=3
{% endif %}
dhcp-option=6,{{ network.ap_ip }}
dhcp-authoritative
