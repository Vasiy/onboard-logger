{
  "_comment": "Bike -> ECU -> protocol presets recovered from the GuzziDiag V0.42 embedded INI ([Modells], byte_452348), plus the per-ECU command matrix from the GuzziDiag and IAWDiag decompiles. Reference data only: this logger targets the IAW 5AM and nothing here is dispatched automatically. 'verified_here' = confirmed on the author's own bike. Protocol tag (PF09/PF10/PF1C/PF2C/PF3C) is GuzziDiag's transport variant, it changes the K-line bring-up, not the service IDs.",
  "protocols": {
    "PF09": "oldest transport (P7/P8/16M)",
    "PF10": "15M variant",
    "PF1C": "IAW 5AM / 15RC standard KWP2000 transport",
    "PF2C": "IAW 5AM 8V/4V variant",
    "PF3C": "15M/15RC/5AM Bellagio variant"
  },
  "ecus": {
    "5AM": {
      "name": "Magneti Marelli IAW 5AM",
      "verified_here": true,
      "rli_range": [
        "0x30",
        "0x7F"
      ],
      "init": "fast (BREAK 25/25 ms) or 5-baud slow; then 81, then 83 03 00 FF 00 FF 00 + 10 81 for tests",
      "poll": "21 <rli> -> 61 <rli> <value>, big-endian, value at offset 2, 1..3 bytes",
      "dtc": {
        "read": "18 00 FF 00",
        "clear": "14 FF 00"
      },
      "resets": {
        "tps": "31 21",
        "self_adaptation": "30 7E 04"
      },
      "actuators": {
        "coil_front": "0x02",
        "coil_rear": "0x03",
        "stepper": "0x04",
        "fuel_pump": "0x05",
        "tacho": "0x06",
        "inj_front": "0x08",
        "inj_rear": "0x09",
        "idle_control?": "0x20"
      },
      "co_trim": {
        "test": "30 15 07 <value>",
        "store": "30 15 05 <value>",
        "value": "signed -128..127",
        "gate": "coolant >= 40 C, engine off",
        "status": "recovered from GuzziDiag sub_41EFFC, NOT implemented and NOT sniff-verified"
      },
      "source": "GuzziDiag V0.42 sub_42D2DB case 5 + IAWDiag V0.52 family sub_41B3A7"
    },
    "15RC": {
      "name": "IAW 15RC",
      "verified_here": false,
      "resets": {
        "tps": "proprietary byte 0x89",
        "self_adaptation": "proprietary byte 0x8A"
      },
      "note": "adaptations do NOT use KWP services: raw byte + echo handshake (GuzziDiag sub_405BEB)",
      "source": "GuzziDiag V0.42 sub_429810 / sub_429826"
    },
    "MIUG3": {
      "name": "MIU G3",
      "verified_here": false,
      "resets": {
        "tps": "31 21"
      },
      "note": "KWP services, different transport layer (GuzziDiag sub_4173A7)",
      "source": "GuzziDiag V0.42 sub_40AA8B / sub_40AAB5"
    },
    "7SM": {
      "name": "IAW 7SM (California 1400)",
      "verified_here": false,
      "resets": {
        "tps_learn": "31 23, then poll 33 23 every 500 ms (up to 20 times)"
      },
      "note": "full TPS learn procedure, not a plain reset",
      "source": "GuzziDiag V0.42 sub_4035DE + sub_41CEB7"
    },
    "15M": {
      "name": "IAW 15M",
      "verified_here": false,
      "source": "GuzziDiag [Modells]"
    },
    "16M": {
      "name": "IAW 16M",
      "verified_here": false,
      "source": "GuzziDiag [Modells]"
    },
    "P7": {
      "name": "IAW P7",
